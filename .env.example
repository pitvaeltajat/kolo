# --- Auth (shared pitva.fi sign-in) ----------------------------------------
# Must match klapi/budu EXACTLY for one sign-in to cover all three (same secret,
# and the cookie name in lib/auth.ts is hard-coded to the shared one).
NEXTAUTH_SECRET=
AUTH_COOKIE_DOMAIN=.pitva.fi          # unset on localhost/preview → host-scoped cookie
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google's `hd` claim is always the PRIMARY domain, so gate on that even though
# members may use the pitva.fi alias in their address.
GOOGLE_WORKSPACE_DOMAIN=pitkajarvenvaeltajat.fi

# Local only: password-free sign-in. NEVER set in production (and it's ignored there).
# ENABLE_DEV_LOGIN=true

# --- Access group (authorisation) ------------------------------------------
ACCESS_GROUP=                         # the existing "all members" group used for access control (confirm its email)
ADMIN_EMAILS=                         # comma-sep; empty = every member may admin tags
GOOGLE_DIRECTORY_SUBJECT=admin@pitkajarvenvaeltajat.fi   # a real admin the service account impersonates
GOOGLE_WORKSPACE_SA_KEY=              # service-account JSON (raw or base64) with domain-wide delegation

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/kolo

# --- Device transport (MQTT) ------------------------------------------------
MQTT_URL=mqtts://your-broker:8883     # unset → door/heating commands return a clear "not configured"
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_HMAC_KEY=                       # shared signing key; per-device override via DEVICE_HMAC_KEY_<ID>

# --- Heating (Google Calendar schedule) -------------------------------------
# "PitVa – Kolo" calendar (events here trigger pre-heating). Created 2026-10-20.
HEATING_CALENDAR_ID=c_e7cc3f92ed1f403454269abc3dda180abdefe62b623389109970d05d0b188579@group.calendar.google.com
HEATING_CALENDAR_SUBJECT=admin@pitkajarvenvaeltajat.fi   # whom to impersonate; the calendar is shared to the domain so any member works too

# --- Door log mirror (optional Google Sheet) --------------------------------
DOOR_LOG_SHEET_ID=
DOOR_LOG_SHEET_SUBJECT=

# --- Crons + alerts ---------------------------------------------------------
CRON_SECRET=                           # Vercel Cron sends this as a Bearer token
RESEND_API_KEY=                        # heartbeat alert email (optional)
NOTIFY_FROM=kolo@pitva.fi
NOTIFY_TO=                             # comma-sep admin addresses
