# This folder also holds PitVa's kolo building-document archive (PDFs, DWGs,
# scans). The app repo tracks only its own source, so ignore everything at the
# root by default and re-include the app paths below. The documents stay on
# disk, untouched — just not in git. Drop a path from the ignore (or remove the
# leading `/*`) if you want them versioned too.
/*

!/.gitignore
!/.env.example
!/README.md
!/DEPLOY.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/next.config.ts
!/next-env.d.ts
!/vercel.json
!/postcss.config.mjs
!/eslint.config.mjs
!/vitest.config.ts
!/app/
!/lib/
!/components/
!/devices/
!/prisma/
!/public/
!/types/
!/suunnitelmat/

# Build output / local junk, even inside the re-included dirs.
node_modules/
.next/
.env
.env*.local
.DS_Store
*.tsbuildinfo
.vercel
.env*

# ESP-IDF firmware (devices/esp32-c3) — generated files that are not source.
devices/esp32-c3/build/
devices/esp32-c3/sdkconfig
devices/esp32-c3/sdkconfig.old
devices/esp32-c3/test/build-test/
devices/esp32-c3/managed_components/

# ESPHome device secrets (never commit).
devices/esp32/secrets.yaml
